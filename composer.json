{
	"name": "konradmichalik/phpstan-typo3-preset",
	"description": "TYPO3 preset configuration for PHPStan",
	"license": "GPL-3.0-or-later",
	"type": "library",
	"authors": [
		{
			"name": "Konrad Michalik",
			"email": "hej@konradmichalik.dev",
			"role": "Maintainer"
		}
	],
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"ergebnis/phpstan-rules": "^2.13",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"rector/type-perfect": "^2.0",
		"saschaegerer/phpstan-typo3": "^2.0 || ^3.0",
		"spaze/phpstan-disallowed-calls": "^4.0",
		"tomasvotruba/cognitive-complexity": "^1.0",
		"tomasvotruba/type-coverage": "^2.0.1 <2.3.0"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.0",
		"ergebnis/composer-normalize": "^2.44"
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": false,
			"typo3/cms-composer-installers": false
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"extra": {
		"phpstan": {
			"includes": [
				"extension.neon"
			]
		}
	},
	"scripts": {
		"fix": [
			"@fix:composer",
			"@fix:editorconfig"
		],
		"fix:composer": "@composer normalize",
		"fix:editorconfig": "@lint:editorconfig --fix",
		"lint": [
			"@lint:composer",
			"@lint:editorconfig"
		],
		"lint:composer": "@fix:composer --dry-run",
		"lint:editorconfig": "ec --git-only",
		"test": "phpstan analyse -c tests/phpstan.neon --no-progress --error-format=json | php tests/check-errors.php",
		"test:update": "phpstan analyse -c tests/phpstan.neon --no-progress --error-format=json | php tests/check-errors.php --update"
	}
}
